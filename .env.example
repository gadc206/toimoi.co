# Copy to `.env.local` and fill in (never commit `.env.local`).
# Pull from Vercel (no global CLI): `pnpm vercel:link` then `pnpm vercel:env-pull`
# Default pull uses the Development environment. If GOOGLE_* only exist on Production/Preview in Vercel, run:
#   pnpm vercel:env-pull:prod
# Or add the same variables to "Development" (or "All Environments") in Vercel → Settings → Environment Variables.
# Or copy each value from Vercel → Project → Settings → Environment Variables.

GOOGLE_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste full PEM on one line, or use \n for line breaks inside the string.
GOOGLE_PRIVATE_KEY=

# Optional: tab and column span (must match sheet tab name and 10 columns).
# GOOGLE_SHEET_RANGE=survey!A:J

# Optional: only needed when users attach a photo/video on the join form.
# BLOB_READ_WRITE_TOKEN=
